# অন্য ডাটাবেজ দিতে চাইলে শুধু নিচের URL এবং প্রয়োজনে credentials ফাইল পরিবর্তন করলেই হবে।
FIREBASE_DB_URL=https://webhost-15839-default-rtdb.firebaseio.com
