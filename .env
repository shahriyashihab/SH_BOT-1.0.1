# ============================================================
#  OPTIONAL SETTINGS (নিচেরগুলো বাদ দিলেও বট ডিফল্ট নিয়ে চলে)
# ============================================================

# --- SQLite storage file path ---
# SQLITE_DB_PATH=data/bot_data.db

# --- DB write ব্যর্থ/refused হলে fallback snapshot (আমার safety net) ---
# STORAGE_FALLBACK_JSON=data/bot_data.fallback.json

# --- External Redis (না দিলেও LRU cache-এ কাজ করে) ---
# REDIS_URL=

# --- DB backup / retention (memory_manager) ---
# DB_BACKUP_INTERVAL_SECONDS=3600
# DB_BACKUP_RETENTION=5
# DB_LOG_RETENTION_DAYS=90
# DB_RETENTION_CLEANUP_INTERVAL_SECONDS=86400

# --- Session file cleanup (ঘণ্টায়) ---
# SESSION_FILE_RETENTION_HOURS=720

# --- একসাথে কতগুলো delayed verify task চলবে ---
# The concurrency cap only bounds the SHORT check phase (2FA -> spam -> device).
# It scales automatically with the number of configured APIs: default is
# PER_API_CONCURRENCY (10) per API. So with 5 APIs the cap is 50, and adding
# APIs raises it automatically. The connection-free deadline wait is uncapped,
# so thousands of pending sessions can wait without occupying a slot.
#
# Uncomment only for manual tuning (overrides the automatic API-scaled value):
# DELAYED_TASK_MAX_CONCURRENCY=10
# PER_API_CONCURRENCY=10

# --- Pyrogram update-processing workers (ডিফল্ট 16, বড় scale-এর জন্য) ---
# বটের মেসেজ হ্যান্ডলিং-এর concurrent worker সংখ্যা। Pyrogram-এর ডিফল্ট 4;
# হাজার হাজার user-এর জন্য 16 রাখলে মেসেজ দ্রুত প্রসেস হয়।
# PYROGRAM_WORKERS=16

# ============ HIGH-SCALE TUNING (OPTIONAL) ============
# নিচেরগুলো দিলে বট API সংখ্যা অনুযায়ী নিজে থেকে স্কেল হয় (ডিফল্ট)।
# ম্যানুয়াল টিউনিং চাইলে শুধু আনকমেন্ট করুন:

# --- Monitor কত সেকেন্ড পর পর pending session scan করবে (ডিফল্ট 60s) ---
# MONITOR_INTERVAL_SECONDS=60

# --- Startup recovery একসাথে কতগুলো session প্রসেস করবে ---
# ডিফল্ট: প্রতি API-এর জন্য 2, সর্বনিম্ন 20 (API অনুপাতে অটো-স্কেল)।
# RECOVERY_PER_API_CONCURRENCY=2
# RECOVERY_CONCURRENCY_MIN=20
# RECOVERY_MAX_CONCURRENCY=0

# --- Startup recovery ব্যাচ সাইজ (ডিফল্ট: প্রতি API-এ 2, min 20) ---
# RECOVERY_PER_API_PARALLEL=2
# RECOVERY_PARALLEL_MIN=20
# RECOVERY_PARALLEL_LIMIT=0

# ============ FIREBASE REALTIME DATABASE ============
